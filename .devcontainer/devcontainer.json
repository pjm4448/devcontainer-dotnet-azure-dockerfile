{
  "name": "Learn Dev Containers - Dockerfile, .NET and Azure",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "args": {
      "IMAGE_GREETING": "Hello from a Dockerfile-built dev container!"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0"
    },
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "installBicep": true
    }
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-azuretools.vscode-bicep"
      ]
    }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Hello Dockerfile API",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "dotnet restore src/HelloDockerfile/HelloDockerfile.csproj"
}
